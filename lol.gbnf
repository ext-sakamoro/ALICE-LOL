# ─── Operations (Boolean / combining constructs) ──────────────────────
#
# op_variadic:  name(expr, expr, ...) with 2+ children.
# op_k_children: name(number, expr, expr, ...) — smoothing family.
# op_2k_children: name(number, number, expr, expr, ...) — stairs/columns.
# op_ab: name(expr, expr) — subtract / xor.
# op_1f_ab: name(number, expr, expr) — smooth_subtract / morph etc.
# op_2f_ab: name(number, number, expr, expr).

op_variadic ::= name_variadic ws "(" ws expr ws exprtail exprtail* ")"
op_k_children ::= name_k_children ws "(" ws number ws exprtail exprtail exprtail* ")"
op_2k_children ::= name_2k_children ws "(" ws number ws "," ws number ws exprtail exprtail exprtail* ")"
op_ab ::= name_ab ws "(" ws expr ws "," ws expr ws ")"
op_1f_ab ::= name_1f_ab ws "(" ws number ws "," ws expr ws "," ws expr ws ")"
op_2f_ab ::= name_2f_ab ws "(" ws number ws "," ws number ws "," ws expr ws "," ws expr ws ")"

exprtail ::= "," ws expr ws

name_variadic ::= "union" | "intersection"

name_k_children ::= "smooth_union"
                  | "smooth_intersection"
                  | "chamfer_union"
                  | "chamfer_intersection"
                  | "exp_smooth_union"
                  | "exp_smooth_intersection"

name_2k_children ::= "stairs_union"
                   | "stairs_intersection"
                   | "columns_union"
                   | "columns_intersection"

name_ab ::= "subtract" | "xor"

name_1f_ab ::= "smooth_subtract"
             | "chamfer_subtraction"
             | "pipe"
             | "engrave"
             | "exp_smooth_subtraction"
             | "morph"

name_2f_ab ::= "groove"
             | "tongue"
             | "stairs_subtraction"
             | "columns_subtraction"

# ─── Modifiers / transforms (floats + one child) ──────────────────────
#
# mod_1f_child:    name(number, expr)
# mod_2f_child:    name(number, number, expr)  — animate only
# mod_3f_child:    name(number, number, number, expr)
# mod_6f_child:    name(number, number, number, number, number, number, expr)
# mod_child_only:  name(expr)

mod_1f_child ::= name_1f_child ws "(" ws number ws "," ws expr ws ")"
mod_2f_child ::= name_2f_child ws "(" ws number ws "," ws number ws "," ws expr ws ")"
mod_3f_child ::= name_3f_child ws "(" ws number ws "," ws number ws "," ws number ws "," ws expr ws ")"
mod_6f_child ::= name_6f_child ws "(" ws number ws "," ws number ws "," ws number ws "," ws number ws "," ws number ws "," ws number ws "," ws expr ws ")"
mod_child_only ::= name_child_only ws "(" ws expr ws ")"

name_1f_child ::= "scale"
                | "round"
                | "onion"
                | "twist"
                | "bend"
                | "revolution"
                | "extrude"
                | "taper"
                | "displacement"
                | "polar_repeat"
                | "with_material"

name_2f_child ::= "animate"

name_3f_child ::= "translate"
                | "rotate"
                | "scale_non_uniform"
                | "mirror"
                | "repeat"
                | "elongate"
                | "shear"
                | "noise"
                | "surface_roughness"
                | "lattice_infill"
                | "diamond_infill"
                | "schwarz_infill"

name_6f_child ::= "repeat_finite" | "sweep_bezier"

name_child_only ::= "octant_mirror" | "icosahedral_symmetry"
